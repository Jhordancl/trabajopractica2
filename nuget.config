<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Redirige los paquetes NuGet a una ruta sin caracteres especiales -->
    <!-- Necesario porque el usuario de Windows contiene "}" que rompe MSBuild -->
    <add key="globalPackagesFolder" value="C:\NuGetPackages" />
  </config>
</configuration>
