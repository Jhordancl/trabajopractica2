@model IEnumerable<PlataformaCreditos.Models.SolicitudCredito>
@{
    ViewData["Title"] = "Panel de Analista de Riesgo";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-shield-check text-primary me-2"></i>Panel de Analista de Riesgo</h2>
            <p class="text-muted mb-0">Evaluación y gestión de solicitudes de crédito pendientes</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2">
            Rol: Analista
        </span>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Solicitudes en Estado Pendiente</h5>
            <span class="badge bg-warning text-dark">@Model.Count() pendientes</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                    <h5>No hay solicitudes pendientes de evaluación</h5>
                    <p class="mb-0">Todas las solicitudes recibidas han sido procesadas.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#ID</th>
                                <th>Fecha Solicitud</th>
                                <th>Ingresos Cliente</th>
                                <th>Monto Solicitado</th>
                                <th>Límite Aprobación (5×)</th>
                                <th>Diagnóstico</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                var ingresos = s.Cliente?.IngresosMensuales ?? 0m;
                                var limiteAprobacion = ingresos * 5;
                                var esAprobable = s.MontoSolicitado <= limiteAprobacion;

                                <tr>
                                    <td class="fw-bold">#@s.Id</td>
                                    <td>@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@ingresos.ToString("C2")</td>
                                    <td class="fw-semibold">@s.MontoSolicitado.ToString("C2")</td>
                                    <td>@limiteAprobacion.ToString("C2")</td>
                                    <td>
                                        @if (esAprobable)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check me-1"></i>Aprobable
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger" title="Supera 5× los ingresos del cliente">
                                                <i class="bi bi-x me-1"></i>Supera 5× Ingresos
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <!-- Formulario de Aprobación -->
                                            <form asp-action="Aprobar" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm btn-success me-1" 
                                                        onclick="return confirm('¿Está seguro de aprobar la solicitud #@s.Id por @s.MontoSolicitado.ToString("C2")?');"
                                                        @(esAprobable ? "" : "disabled")>
                                                    <i class="bi bi-check-lg me-1"></i>Aprobar
                                                </button>
                                            </form>

                                            <!-- Botón modal Rechazar -->
                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#modalRechazar-@s.Id">
                                                <i class="bi bi-x-lg me-1"></i>Rechazar
                                            </button>
                                        </div>

                                        <!-- Modal de Rechazo con Motivo Obligatorio -->
                                        <div class="modal fade" id="modalRechazar-@s.Id" tabindex="-1" aria-labelledby="modalRechazarLabel-@s.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <form asp-action="Rechazar" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@s.Id" />
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title" id="modalRechazarLabel-@s.Id">Rechazar Solicitud #@s.Id</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p><strong>Cliente:</strong> @s.Cliente?.UsuarioId</p>
                                                            <p><strong>Monto:</strong> @s.MontoSolicitado.ToString("C2")</p>
                                                            <div class="mb-3">
                                                                <label for="motivoRechazo-@s.Id" class="form-label fw-bold">
                                                                    Motivo del Rechazo <span class="text-danger">*</span>
                                                                </label>
                                                                <textarea class="form-control" id="motivoRechazo-@s.Id" name="motivoRechazo" rows="3" required placeholder="Especifique la justificación del rechazo (obligatorio)..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-danger">Confirmar Rechazo</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
